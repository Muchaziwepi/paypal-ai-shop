# Fill these in, then save. Never commit this file (it is in .gitignore).

# PayPal Developer Dashboard > Apps & Credentials > (Sandbox tab) > your app
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI assistant (optional - without a key, a simple keyword matcher is used)
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# Order storage (optional - without it, orders are saved to data/orders.json)
MONGODB_URI=

# Password for the /orders.html page
ADMIN_KEY=change-me

PORT=3000
